{
  "name": "postman-project",
  "version": "1.0.0",
  "description": "API Test Automation for JSONPlaceholder using Postman CLI",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "postman collection run postman/collections/jsonplaceholder.postman_collection -e postman/environments/Local.environment.yaml --reporters cli",
    "test:smoke": "postman collection run postman/collections/jsonplaceholder.postman_collection -e postman/environments/Local.environment.yaml -i \"Smoke Tests\" --reporters cli",
    "test:regression": "postman collection run postman/collections/jsonplaceholder.postman_collection -e postman/environments/Local.environment.yaml -i \"Regression Tests\" --reporters cli",
    "test:positive": "postman collection run postman/collections/jsonplaceholder.postman_collection -e postman/environments/Local.environment.yaml -i \"Positive Tests\" --reporters cli",
    "test:negative": "postman collection run postman/collections/jsonplaceholder.postman_collection -e postman/environments/Local.environment.yaml -i \"Negative Tests\" --reporters cli",
    "test:staging": "postman collection run postman/collections/jsonplaceholder.postman_collection -e postman/environments/Staging.environment.yaml --reporters cli",
    "test:production": "postman collection run postman/collections/jsonplaceholder.postman_collection -e postman/environments/Production.environment.yaml --reporters cli"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arvoldek/postman-project.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Arvoldek/postman-project/issues"
  },
  "homepage": "https://github.com/Arvoldek/postman-project#readme",
  "devDependencies": {
    "js-yaml": "^4.1.1",
    "postman-cli": "^1.38.0"
  }
}
